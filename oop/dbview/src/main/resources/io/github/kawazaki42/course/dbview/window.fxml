<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.kawazaki42.course.dbview.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TableView fx:id="table" editable="true" />

    <HBox>
        <Button onAction="#onAddButtonClick" text="add null" />
        <Button onAction="#onDeleteButtonClick" text="delete selected" />
    </HBox>

</VBox>
