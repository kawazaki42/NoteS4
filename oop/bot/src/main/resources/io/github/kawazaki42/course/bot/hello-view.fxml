<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" onKeyTyped="#onKeyTyped" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.kawazaki42.course.bot.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="200.0" prefWidth="200.0">
        <VBox fx:id="dialog" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label minWidth="-Infinity" text="Label" wrapText="true" />
         </children>
        </VBox>
    </ScrollPane>
    <HBox prefHeight="100.0" prefWidth="200.0">
        <TextArea fx:id="prompt" onKeyPressed="#onKeyPressed" prefHeight="200.0" prefWidth="200.0" />
        <Button defaultButton="true" onAction="#sendPrompt" text="Send" />
    </HBox>
</VBox>
