<dbmodel pgmodeler-ver="1.1.0-beta1" use-changelog="false" last-position="0,156" last-zoom="0.75" max-obj-count="8"
	 default-schema="public"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="workload" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="lecturer" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<position x="220" y="940"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="surname" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="first_name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="patronym">
		<type name="text" length="0"/>
	</column>
	<column name="department" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="degree" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="administrative_duty">
		<type name="text" length="0"/>
	</column>
	<column name="work_begin_year">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="lecturer_pk" type="pk-constr" table="public.lecturer">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="discipline" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<position x="1220" y="100"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="discipline_pk" type="pk-constr" table="public.discipline">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="group" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<position x="280" y="540"/>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="begin_year">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="group_pk" type="pk-constr" table="public.&quot;group&quot;">
		<columns names="name" ref-type="src-columns"/>
	</constraint>
	<constraint name="minimum" type="ck-constr" table="public.&quot;group&quot;">
			<expression> <![CDATA[begin_year > 1900]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_speciality" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="speciality_fk" index="1"/>
	</customidxs></table>

<table name="lesson" layers="0" collapse-mode="2" max-obj-count="6" z-value="0">
	<schema name="public"/>
	<position x="940" y="920"/>
	<column name="semester_relative" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="lesson_pk" type="pk-constr" table="public.lesson">
		<columns names="semester_relative" ref-type="src-columns"/>
	</constraint>
	<constraint name="sem_number" type="ck-constr" table="public.lesson">
			<expression> <![CDATA[semester_relative BETWEEN 1 and 20]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_lecturer" index="3"/>
		<object name="id_standard" index="2"/>
		<object name="name_group" index="0"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="group_fk" index="1"/>
		<object name="lecturer_fk" index="2"/>
		<object name="standard_fk" index="3"/>
	</customidxs></table>

<relationship name="many_lessons_for_group" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#adce68"
	 src-table="public.&quot;group&quot;"
	 dst-table="public.lesson"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="50.2902" y="-65.8485"/>
	</label>
</relationship>

<table name="kind" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<position x="1820" y="100"/>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="kind_pk" type="pk-constr" table="public.kind">
		<columns names="name" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="lecturer_has_many_lesson" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#7de34e"
	 src-table="public.lecturer"
	 dst-table="public.lesson"
	 src-required="true" dst-required="false"
	 identifier="true"
/>

<table name="standard" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<position x="1720" y="620"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="study_hours" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="standard_pk" type="pk-constr" table="public.standard">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="nonzero" type="ck-constr" table="public.standard">
			<expression> <![CDATA[study_hours > 0]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_discipline" index="1"/>
		<object name="id_speciality" index="3"/>
		<object name="name_kind" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="discipline_fk" index="1"/>
		<object name="kind_fk" index="0"/>
		<object name="speciality_fk" index="2"/>
	</customidxs></table>

<relationship name="many_standards_have_one_kind" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#5da3ea"
	 src-table="public.kind"
	 dst-table="public.standard"
	 src-required="true" dst-required="false"/>

<relationship name="many_standards_have_one_discipline" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#719a10"
	 src-table="public.discipline"
	 dst-table="public.standard"
	 src-required="true" dst-required="false"/>

<table name="speciality" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<position x="880" y="320"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="speciality_pk" type="pk-constr" table="public.speciality">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="group_pertains_to_speciality" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#47a810"
	 src-table="public.speciality"
	 dst-table="public.&quot;group&quot;"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

<relationship name="speciality_has_many_standard" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#fe374f"
	 src-table="public.speciality"
	 dst-table="public.standard"
	 src-required="true" dst-required="false"/>

<relationship name="lesson_implements_standard" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#866ed1"
	 src-table="public.standard"
	 dst-table="public.lesson"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

<function name="casefold_name"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="1"
		row-amount="0">
	<schema name="public"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[BEGIN
  NEW.name := LOWER(TRIM(NEW.name));
  RETURN NEW;
END]]> </definition>
</function>

<trigger name="casefold" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="false" upd-event="true" trunc-event="false"
	 table="public.kind">
		<function signature="public.casefold_name()"/>
</trigger>

<function name="validate_cycle"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="1"
		row-amount="0">
	<schema name="public"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[DECLARE
  from_group INTEGER;
  from_standard INTEGER;
BEGIN
  SELECT id_speciality
    INTO from_group
    FROM "group"
    WHERE name = NEW.name_group;

  SELECT id_speciality
    INTO from_standard
    FROM standard
    WHERE id = NEW.id_standard;

  IF from_group != from_standard THEN
    RAISE 'inconsistent';
  ELSE
    RETURN NEW;
  END IF;
END]]> </definition>
</function>

<trigger name="validate_cycle" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="false" upd-event="true" trunc-event="false"
	 table="public.lesson">
		<function signature="public.validate_cycle()"/>
</trigger>

<constraint name="primary" type="uq-constr" table="public.standard">
	<columns names="id_discipline,name_kind,id_speciality" ref-type="src-columns"/>
</constraint>

</dbmodel>
